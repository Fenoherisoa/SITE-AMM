{
  "name": "site-amm",
  "productName": "SITE-AMM",
  "private": true,
  "version": "2.1.0",
  "description": "Application Windows et Portail Métiers de l'Association Malagasy Miray (AMM)",
  "author": "Association Malagasy Miray",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "lan:server": "tsx server/lanServer.ts",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node20 --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --target=node20 --outfile=dist-electron/preload.cjs --external:electron",
    "electron:dev": "npm run build:electron && electron .",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win --x64",
    "dist:dir": "npm run build && npm run build:electron && electron-builder --dir",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-electron release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capgo/capacitor-native-biometric": "^8.6.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "org.malagasymiray.siteamm",
    "productName": "SITE-AMM",
    "copyright": "Copyright © 2026 Association Malagasy Miray",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SITE-AMM",
      "uninstallDisplayName": "SITE-AMM - Association Malagasy Miray",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
