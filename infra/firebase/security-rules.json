{
  "rules": {
    "attendance": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('roles').val() != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('permissions').val().indexOf('attendance.manage') !== -1"
    },
    "employees": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('permissions').val().indexOf('rh.read') !== -1)",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('permissions').val().indexOf('rh.update') !== -1)"
    },
    "token_pool": {
      ".read": false,
      ".write": false
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('roles').val().indexOf('SUPER_ADMIN') !== -1",
      ".write": "auth != null && root.child('users').child(auth.uid).child('roles').val().indexOf('SUPER_ADMIN') !== -1"
    },
    "parametres": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('roles').val().indexOf('ADMIN') !== -1"
    },
    ".read": false,
    ".write": false
  }
}
