{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('users.manage').val() === true)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('users.manage').val() === true)",
        "password": {
          ".read": false,
          ".write": false
        },
        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN'"
        },
        "permissions": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN'"
        },
        "accountStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN'"
        }
      }
    },

    "pendingRequests": {
      "$req": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('users.manage').val() === true)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('users.manage').val() === true)",
        "password": {
          ".read": false,
          ".write": false
        }
      }
    },

    "token_pool": {
      ".read": false,
      ".write": false
    },

    "logs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('audit.read').val() === true)",
      ".write": false
    },

    "messages": {
      "$conv": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')",
        ".write": "auth != null && (data.child('participants').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')",
        "participants": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN'"
        }
      }
    },

    "parametres": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('settings.manage').val() === true)"
    },

    "metadata": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('settings.manage').val() === true)",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN'"
    },

    "departments": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('roles.manage').val() === true)"
    },

    "departements": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('roles.manage').val() === true)"
    },

    "positions": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('permissions').child('roles.manage').val() === true)"
    },

    "employees": {
      "$empId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('permissions').child('rh.read').val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN' || root.child('users').child(auth.uid).child('linkedEmployeeId').val() === $empId)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('permissions').child('rh.update').val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')",
        "cin": { 
          ".read": "auth != null && (root.child('users').child(auth.uid).child('permissions').child('rh.read').val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')",
          ".write": "false"
        },
        "cin_recto": { 
          ".read": "false",
          ".write": "false"
        },
        "cin_verso": { 
          ".read": "false",
          ".write": "false"
        },
        "matricule": {
          ".validate": "newData.exists() ? newData.val() === $empId : true",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN'"
        }
      }
    },

    "attendance": {
      "$att": {
        ".read": "auth != null && (data.child('employeeId').val() === root.child('users').child(auth.uid).child('linkedEmployeeId').val() || root.child('users').child(auth.uid).child('permissions').child('attendance.read').val() === true || root.child('users').child(auth.uid).child('role').val() === 'RH')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('permissions').child('attendance.manage').val() === true || root.child('users').child(auth.uid).child('role').val() === 'RH' || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')",
        ".validate": "newData.hasChildren(['employeeId','date'])"
      }
    },

    "pointage": {
      "$date": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('permissions').child('attendance.read').val() === true || root.child('users').child(auth.uid).child('role').val() === 'RH' || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('permissions').child('attendance.manage').val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')"
      }
    },

    "events": {
      "$eventId": {
        ".read": "(data.child('visibility').val() === 'public') || (auth != null && (root.child('users').child(auth.uid).child('permissions').child('events.read').val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN'))",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('permissions').child('events.manage').val() === true || root.child('users').child(auth.uid).child('role').val() === 'SUPER_ADMIN')"
      }
    }
  }
}
